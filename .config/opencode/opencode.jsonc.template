      "url": "${LITELLM_MCP_URL}/grafana/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "prometheus": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/prometheus/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "pihole": {
