{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dotfilesd": {
      "type": "local",
      "command": ["dotfilesctl", "mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users"
      }
    },
    "homeassistant": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/homeassistant/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "homelable": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/homelable/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "pangolin": {
