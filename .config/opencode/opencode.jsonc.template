    },
    "virtualbox": {
      "type": "local",
      "command": ["/home/manu343726/go/bin/mcp-virtualbox"],
      "enabled": true
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "blacklist": [
        "qwen/qwen3-30b-a3b-2507",
        "qwen/qwen3-coder-30b"
      ],
      "models": {
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash",
