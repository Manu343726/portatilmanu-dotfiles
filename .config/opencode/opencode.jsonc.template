{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dotfilesd": {
      "type": "local",
      "command": ["dotfilesctl", "mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users"
      }
    },
    "homeassistant": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/homeassistant/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "homelable": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/homelable/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "pangolin": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/pangolin/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "proxmox": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/proxmox/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "portabase": {
      "type": "remote",
      "url": "${LITELLM_MCP_URL}/portabase/mcp",
      "headers": {
        "Authorization": "Bearer ${LITELLM_MCP_KEY}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "/home/manu343726/.opencode/mcp/playwright/node_modules/.bin/playwright-mcp",
        "--isolated",
        "--caps", "pdf"
      ],
      "enabled": true
    },
    "virtualbox": {
      "type": "local",
      "command": ["/home/manu343726/go/bin/mcp-virtualbox"],
      "enabled": true
    },
    "vaultwarden": {
      "type": "local",
      "command": ["/home/manu343726/.opencode/mcp/warden/node_modules/.bin/warden-mcp", "--stdio"],
      "environment": {
        "BW_HOST": "${VW_HOST}",
        "BW_USER": "${VW_USER}",
        "BW_PASSWORD": "${VW_PASSWORD}",
        "KEYCHAIN_BW_HOME_ROOT": "/home/manu343726/.local/state/warden-mcp"
      },
      "enabled": true
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "blacklist": [
        "qwen/qwen3-30b-a3b-2507",
        "qwen/qwen3-coder-30b"
      ],
      "models": {
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash",
          "reasoning": true
        },
        "zai-org/glm-4.6v-flash": {
          "name": "GLM 4.6V Flash",
          "reasoning": true
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B"
        },
        "deepseek/deepseek-r1-0528-qwen3-8b": {
          "name": "DeepSeek R1 0528 Qwen3 8B",
          "reasoning": true
        }
      }
    }
  }
}
