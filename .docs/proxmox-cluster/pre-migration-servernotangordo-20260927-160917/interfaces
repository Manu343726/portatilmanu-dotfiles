# the PVE managed interfaces into external files!

auto lo
iface lo inet loopback

iface eno1 inet manual

auto vmbr0
iface vmbr0 inet static
	address 192.168.100.5/24
	gateway 192.168.100.1
	bridge-ports eno1
	bridge-stp off
	bridge-fd 0
	# --- added: reachability on the real LAN (192.168.0.0/24) ---
	up ip addr add 192.168.0.240/24 dev vmbr0
	# The "gateway 192.168.100.1" directive installs a metric-0 default that
	# does not exist on this LAN. Drop it, then prefer the real LAN gateway.
	up ip route del default via 192.168.100.1 dev vmbr0 2>/dev/null || true
	up ip route replace default via 192.168.0.1 dev vmbr0 proto static metric 10
	up ip route replace default via 192.168.100.1 dev vmbr0 proto static metric 200
	down ip addr del 192.168.0.240/24 dev vmbr0
	down ip route del default via 192.168.0.1 dev vmbr0 proto static metric 10 2>/dev/null || true
	down ip route replace default via 192.168.100.1 dev vmbr0 proto kernel onlink

iface wlp3s0 inet manual

source /etc/network/interfaces.d/*
