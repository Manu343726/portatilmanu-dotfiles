#!/usr/bin/env python3
"""ASUS ROG Flow X13 (GV301RC) keyboard backlight control.

Why this script exists instead of /sys/class/leds/asus::kbd_backlight/brightness:

`hid-asus` fails to create that LED on this machine at every boot:

    asus 0003:0B05:19B6.0002: using HID for asus::kbd_backlight
    asus 0003:0B05:19B6.0002: Asus failed to request functions: -75
    asus 0003:0B05:19B6.0002: Failed to initialize backlight.

`asus_kbd_register_leds()` calls `asus_kbd_get_functions()`, whose GET_REPORT on
feature report 0x5a comes back -EOVERFLOW, so the driver gives up before
registering the class device. Nothing in userspace can then change the level:
asusd logs `KeyboardLed::new(), asus::kbd_backlight not found` and gives up too.

The early return is worse than a missing sysfs file. A 6.12.y refactor moved
`asus_kbd_get_functions()` *ahead* of the two LED-endpoint handshakes, so the
-EOVERFLOW abort also skips those:

    6.12.0   asus_kbd_init(0x5a) -> asus_kbd_init(0x5d) -> asus_kbd_init(0x5e)
    6.12.y   asus_kbd_init(0x5a) -> asus_kbd_get_functions() -X-> return
                                       (0x5d and 0x5e never run)

hid-asus calls those two "The LED endpoint is initialised in two HID", and a
brightness report is ignored while they stay dormant -- which is why sending
`5a ba c5 c4 <level>` alone changes nothing. So we replay the whole init
sequence before setting a level:

    <id> 41 53 55 53 20 54 65 63 68 2e 49 6e 63 2e 00   for id in 5a, 5d, 5e
    5a ba c5 c4 <level>

The handshake payload is the ASCII string "ASUS Tech.Inc.".

The hardware keys are unaffected by the driver bug -- the N-KEY HID device still
advertises KEY_KBDILLUMTOGGLE/UP/DOWN, which X maps to XF86KbdLightOnOff,
XF86KbdBrightnessUp and XF86KbdBrightnessDown. i3 binds those to this script.

Usage: kbd-backlight up|down|toggle|on|off|set N|get|restore
"""

import fcntl
import os
import subprocess
import sys

# Levels accepted by the firmware; matches hid-asus' cdev.max_brightness.
MAX_LEVEL = 3
# Level assumed the first time the key is pressed after boot.
DEFAULT_LEVEL = 1
# Level restored by `on`/`toggle` once the backlight has been switched off.
LAST_ON_LEVEL = 2

# The N-KEY HID collection that owns feature report 0x5a (the LED endpoint).
# The others exposed by the driver are the media-keys, keyboard and mouse
# interfaces, which have no backlight.
KBD_HID = "0003:0B05:19B6.0002"
HID_DRIVER_DIR = "/sys/bus/hid/drivers/asus"

# Report IDs the driver touches, in the order it touches them.
REPORT_ID = 0x5A
LED_REPORT_ID1 = 0x5D
LED_REPORT_ID2 = 0x5E
REPORT_PREFIX = bytes((REPORT_ID, 0xBA, 0xC5, 0xC4))

# asus_kbd_init()'s payload: "ASUS Tech.Inc." plus a trailing NUL.
HANDSHAKE = bytes((0x41, 0x53, 0x55, 0x53, 0x20, 0x54, 0x65, 0x63,
                   0x68, 0x2E, 0x49, 0x6E, 0x63, 0x2E, 0x00))


def _ioc(direction, typ, nr, size):
    """Linux _IOC() encoding, so the ioctl number below needs no magic value."""
    return (
        (direction << 30)
        | (ord(typ) << 8)
        | (nr << 0)
        | (size << 16)
    )


# HIDIOCSFEATURE(len) = _IOWR('H', 0x06, len)
_HIDIOCSFEATURE = _ioc(2 | 1, "H", 0x06, 0)  # _IOC_READ | _IOC_WRITE


def hidraw_path():
    node = os.path.join(HID_DRIVER_DIR, KBD_HID, "hidraw")
    try:
        names = sorted(os.listdir(node))
    except OSError:
        names = []
    if not names:
        sys.exit(
            f"kbd-backlight: {KBD_HID} is not bound to the asus driver "
            f"(looked in {node}) -- is hid_asus loaded?"
        )
    return f"/dev/{names[0]}"


def state_file():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    return os.path.join(base, "asus-kbd-backlight")


def read_state():
    try:
        with open(state_file(), encoding="ascii") as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return DEFAULT_LEVEL


def write_state(level):
    path = state_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="ascii") as fh:
        fh.write(f"{level}\n")


def open_hidraw():
    path = hidraw_path()
    try:
        return path, os.open(path, os.O_WRONLY)
    except PermissionError:
        sys.exit(
            f"kbd-backlight: no permission to write {path}. The udev rule in "
            f".docs/keyboard.md has to be installed and re-triggered."
        )
    except OSError as exc:
        sys.exit(f"kbd-backlight: cannot open {path}: {exc}")


def set_feature(fd, report, path, label):
    """HIDIOCSFEATURE one report; aborts the whole sequence if it is refused."""
    try:
        fcntl.ioctl(fd, _HIDIOCSFEATURE | (len(report) << 16), report)
    except OSError as exc:
        sys.exit(f"kbd-backlight: HIDIOCSFEATURE {label} on {path} failed: {exc}")


def send(level, verbose=False):
    """Replay hid-asus' init sequence, then set the brightness level."""
    path, fd = open_hidraw()
    try:
        # 0x5a is the keyboard endpoint; 0x5d/0x5e are the two LED endpoints that
        # hid-asus never gets to on this machine. All three are needed before a
        # brightness report does anything.
        for report_id in (REPORT_ID, LED_REPORT_ID1, LED_REPORT_ID2):
            set_feature(
                fd,
                bytearray(bytes((report_id,)) + HANDSHAKE),
                path,
                f"handshake 0x{report_id:02x}",
            )
            if verbose:
                print(f"handshake 0x{report_id:02x}: ok", file=sys.stderr)
        set_feature(fd, bytearray(REPORT_PREFIX + bytes((level,))), path, "brightness")
        if verbose:
            print(f"brightness {level}: ok", file=sys.stderr)
    finally:
        os.close(fd)
    return True


def notify(level):
    if not os.environ.get("DISPLAY"):
        return
    bars = "█" * level + "░" * (MAX_LEVEL - level)
    label = "off" if level == 0 else f"{level}/{MAX_LEVEL}"
    subprocess.run(
        ["notify-send", "Keyboard backlight", f"{label}  {bars}"],
        check=False,
        timeout=5,
    )


def apply(level, quiet=False, verbose=False):
    level = max(0, min(int(level), MAX_LEVEL))
    send(level, verbose=verbose)
    write_state(level)
    if not quiet:
        notify(level)
    return level


def main(argv):
    args = argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    # `kbd-backlight -v <cmd>` traces every feature report on stderr.
    verbose = False
    if args and args[0] in ("-v", "--verbose"):
        verbose = True
        args = args[1:]

    command = args[0] if args else "up"
    current = read_state()

    if command == "up":
        # 0 -> 1 rather than staying dark.
        level = 1 if current == 0 else current + 1
    elif command == "down":
        level = current - 1
    elif command == "toggle":
        level = 0 if current else LAST_ON_LEVEL
    elif command == "on":
        level = LAST_ON_LEVEL if current == 0 else current
    elif command == "off":
        level = 0
    elif command == "set":
        if len(args) < 2:
            sys.exit("kbd-backlight: set needs a level, e.g. `set 2`")
        try:
            level = int(args[1])
        except ValueError:
            sys.exit(f"kbd-backlight: not a number: {args[1]}")
    elif command == "get":
        print(current)
        return 0
    elif command == "restore":
        # Re-assert after suspend: the firmware clears the backlight and the
        # kernel used to do this from hid-asus' resume hook.
        apply(current, quiet=True, verbose=verbose)
        return 0
    else:
        sys.exit(f"kbd-backlight: unknown command: {command}")

    apply(level, verbose=verbose)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))