#!/usr/bin/env zsh
profiles=("performance" "balanced" "power-saver")
current=$(busctl get-property org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles org.freedesktop.UPower.PowerProfiles ActiveProfile 2>/dev/null | tr -d 's "')
choice=$(printf '%s\n' "${profiles[@]}" | rofi -dmenu -p "Power Profile" -mesg "Current: $current" -l 3 -theme /home/manu343726/.config/rofi/monokai.rasi)
[[ -n "$choice" ]] && busctl set-property org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles org.freedesktop.UPower.PowerProfiles ActiveProfile s "$choice" && notify-send "Power Profile" "$choice"
