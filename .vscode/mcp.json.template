{
    "servers": {
        "dotfilesd": {
            "command": "dotfilesctl",
            "args": [
                "mcp"
            ],
            "env": {}
        },
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
                "X-MCP-Toolsets": "context,repos,issues,pull_requests,users"
            }
        },
        "homeassistant": {
            "type": "http",
            "url": "${HA_MCP_URL}",
            "headers": {
                "Authorization": "Bearer ${HA_MCP_TOKEN}"
            }
        }
    }
}
