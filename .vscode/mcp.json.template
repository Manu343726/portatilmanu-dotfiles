{
    "servers": {
        "dotfilesd": {
            "command": "dotfilesctl",
            "args": [
                "mcp"
            ],
            "env": {}
        },
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
                "X-MCP-Toolsets": "context,repos,issues,pull_requests,users"
            }
        },
        "homeassistant": {
            "type": "http",
            "url": "${LITELLM_MCP_URL}/homeassistant/mcp",
            "headers": {
                "Authorization": "Bearer ${LITELLM_MCP_KEY}"
            }
        },
        "homelable": {
            "type": "http",
            "url": "${LITELLM_MCP_URL}/homelable/mcp",
            "headers": {
                "Authorization": "Bearer ${LITELLM_MCP_KEY}"
            }
        },
        "pangolin": {
            "type": "http",
            "url": "${LITELLM_MCP_URL}/pangolin/mcp",
            "headers": {
                "Authorization": "Bearer ${LITELLM_MCP_KEY}"
            }
        },
        "proxmox": {
            "type": "http",
            "url": "${LITELLM_MCP_URL}/proxmox/mcp",
            "headers": {
                "Authorization": "Bearer ${LITELLM_MCP_KEY}"
            }
        },
        "portabase": {
            "type": "http",
            "url": "${LITELLM_MCP_URL}/portabase/mcp",
            "headers": {
                "Authorization": "Bearer ${LITELLM_MCP_KEY}"
            }
        },
        "playwright": {
            "type": "http",
            "url": "${LITELLM_MCP_URL}/playwright/mcp",
            "headers": {
                "Authorization": "Bearer ${LITELLM_MCP_KEY}"
            }
        }
    }
}
